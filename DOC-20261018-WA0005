<script>
(function(){
"use strict";
const $=(s,r=document)=>r.querySelector(s);
const $$=(s,r=document)=>Array.from(r.querySelectorAll(s));
const fmt=(n,d=0)=>Number(n).toLocaleString("en-IN",{minimumFractionDigits:d,maximumFractionDigits:d});
const set=(id,t)=>{const e=document.getElementById(id);if(e)e.textContent=t;};
const pad=n=>String(n).padStart(2,"0");

/* Theme */
const root=document.documentElement, tbtn=$("#themeBtn");
const systemDark=()=>!!(window.matchMedia&&matchMedia("(prefers-color-scheme: dark)").matches);
const effective=()=>root.getAttribute("data-theme")||(systemDark()?"dark":"light");
function paintTheme(){const d=effective()==="dark";tbtn.setAttribute("aria-label",d?"Switch to light theme":"Switch to dark theme");tbtn.dataset.mode=d?"dark":"light";}
try{const s=localStorage.getItem("theme");if(s==="light"||s==="dark")root.setAttribute("data-theme",s);}catch(e){}
tbtn.addEventListener("click",()=>{const n=effective()==="dark"?"light":"dark";root.setAttribute("data-theme",n);try{localStorage.setItem("theme",n);}catch(e){}paintTheme();});
paintTheme();

/* Menu and active section */
const mbtn=$("#menuBtn"), nav=$("#siteNav");
mbtn.addEventListener("click",()=>{const o=nav.classList.toggle("open");mbtn.setAttribute("aria-expanded",String(o));mbtn.setAttribute("aria-label",o?"Close menu":"Open menu");});
$$("a",nav).forEach(a=>a.addEventListener("click",()=>{nav.classList.remove("open");mbtn.setAttribute("aria-expanded","false");mbtn.setAttribute("aria-label","Open menu");}));
if("IntersectionObserver" in window){
  const links=$$("a",nav), map={};
  links.forEach(a=>{map[a.getAttribute("href").slice(1)]=a;});
  const io=new IntersectionObserver(es=>{es.forEach(e=>{if(e.isIntersecting){links.forEach(l=>l.removeAttribute("aria-current"));const l=map[e.target.id];if(l)l.setAttribute("aria-current","true");}});},{rootMargin:"-35% 0px -60% 0px"});
  Object.keys(map).forEach(id=>{const el=document.getElementById(id);if(el)io.observe(el);});
}

/* Demand planner */
$("#plannerForm").addEventListener("submit",e=>e.preventDefault());
function readP(){
  const d=$('input[name="day"]:checked');
  return {
    students:+$("#students").value, day:d?+d.value:0.95, eat:+$("#eat").value/100,
    optout:+$("#optout").value, batch:+$("#batch").value,
    portionG:Math.max(100,+$("#portionG").value||350), cost:Math.max(0,+$("#cost").value||0)
  };
}
function model(p){
  const demand=Math.max(0,Math.round(p.students*p.day*p.eat)-p.optout);
  const cookFixed=p.batch, cookSmart=Math.ceil(demand*1.05);
  const servedFixed=Math.min(cookFixed,demand), servedSmart=Math.min(cookSmart,demand);
  const unsoldFixed=Math.max(0,cookFixed-demand), unsoldSmart=cookSmart-servedSmart;
  const kg=p.portionG/1000;
  const wasteFixed=(unsoldFixed+0.10*servedFixed)*kg, wasteSmart=(unsoldSmart+0.06*servedSmart)*kg;
  return {demand,cookFixed,cookSmart,unsoldSmart,short:Math.max(0,demand-cookFixed),wasteFixed,wasteSmart,
    cut:wasteFixed>0?(wasteFixed-wasteSmart)/wasteFixed:0, costDiff:(cookFixed-cookSmart)*p.cost};
}
const pct=v=>Math.max(0,Math.min(100,v*100))+"%";
function renderPlanner(){
  const p=readP(), m=model(p);
  set("studentsOut",fmt(p.students)); set("eatOut",Math.round(p.eat*100)+"%");
  set("optoutOut",fmt(p.optout)); set("batchOut",fmt(p.batch));
  set("rDemand",fmt(m.demand));
  set("rCalc",fmt(p.students)+" students × "+Math.round(p.day*100)+"% on campus × "+Math.round(p.eat*100)+"% eat here − "+fmt(p.optout)+" opt-outs");
  const cmax=Math.max(m.cookFixed,m.cookSmart,1);
  $("#bCookFixed").style.width=pct(m.cookFixed/cmax); $("#bCookSmart").style.width=pct(m.cookSmart/cmax);
  $("#mCookFixed").style.left=pct(m.demand/cmax); $("#mCookSmart").style.left=pct(m.demand/cmax);
  set("vCookFixed",fmt(m.cookFixed)); set("vCookSmart",fmt(m.cookSmart));
  const wmax=Math.max(m.wasteFixed,m.wasteSmart,0.001);
  $("#bWasteFixed").style.width=pct(m.wasteFixed/wmax); $("#bWasteSmart").style.width=pct(m.wasteSmart/wmax);
  set("vWasteFixed",fmt(m.wasteFixed,1)); set("vWasteSmart",fmt(m.wasteSmart,1));
  const warn=$("#nShort");
  if(m.short>0){warn.hidden=false;warn.textContent="The fixed batch runs out. About "+fmt(m.short)+" students would go without a meal.";}else{warn.hidden=true;}
  if(m.cut>=0){set("kCut",Math.round(m.cut*100)+"%");set("kCutSub","less food wasted than a fixed batch");}
  else{set("kCut","+"+Math.round(-m.cut*100)+"%");set("kCutSub","more waste, because the fixed batch falls short");}
  const month=m.costDiff*26;
  if(m.costDiff>=0){set("kSaveLabel","Food cost avoided");set("kSave","₹"+fmt(m.costDiff));set("kSaveSub","per day · ₹"+fmt(month)+" over 26 days");}
  else{set("kSaveLabel","Extra cost to meet demand");set("kSave","₹"+fmt(-m.costDiff));set("kSaveSub","per day · ₹"+fmt(-month)+" over 26 days");}
  set("kNgo",fmt(m.unsoldSmart));
}
$("#plannerForm").addEventListener("input",renderPlanner);
renderPlanner();

/* Smart bin */
const MEALS=["Breakfast","Lunch","Snacks"];
const MCLS={Breakfast:"b",Lunch:"l",Snacks:"s"};
const DISHES={Breakfast:["Idli & sambar","Puttu & kadala","Upma"],Lunch:["Rice","Sambar & veg curry","Chapati","Salad & pickle"],Snacks:["Parippu vada","Banana fry","Samosa"]};
const CAP=20000;
const freshBin=()=>({total:8420,byMeal:{Breakfast:3100,Lunch:5320,Snacks:0},
  byDish:{"Idli & sambar":1600,"Puttu & kadala":1500,"Rice":3900,"Sambar & veg curry":1420},
  tape:[{t:"12:52",meal:"Lunch",dish:"Sambar & veg curry",g:150},{t:"12:36",meal:"Lunch",dish:"Rice",g:310},{t:"08:40",meal:"Breakfast",dish:"Puttu & kadala",g:240},{t:"08:12",meal:"Breakfast",dish:"Idli & sambar",g:180}]});
let bin=freshBin(), binMeal="Lunch", binMsg="";
const dishSel=$("#dishSel");
function fillDishes(){dishSel.innerHTML=DISHES[binMeal].map(d=>'<option value="'+d+'">'+d.replace(/&/g,"&amp;")+"</option>").join("");}
function renderMealChips(){
  $("#binMealChips").innerHTML=MEALS.map(m=>'<button type="button" class="chip" data-meal="'+m+'" aria-pressed="'+(m===binMeal)+'"><span class="dot '+MCLS[m]+'"></span>'+m+"</button>").join("");
}
$("#binMealChips").addEventListener("click",e=>{const b=e.target.closest("button[data-meal]");if(!b)return;binMeal=b.dataset.meal;renderMealChips();fillDishes();});
function renderBin(){
  const f=Math.min(1,bin.total/CAP), h=130*f;
  $("#binKg").textContent=(bin.total/1000).toFixed(2);
  $("#binFill").setAttribute("y",String(170-h)); $("#binFill").setAttribute("height",String(h));
  set("binPct",Math.round(f*100)+"% of "+(CAP/1000)+" kg");
  $("#binMeals").innerHTML=MEALS.map(m=>{const g=bin.byMeal[m];const w=bin.total>0?g/bin.total*100:0;
    return '<div class="mrow"><span>'+m+'</span><div class="track"><i class="'+MCLS[m]+'" style="width:'+w+'%"></i></div><b>'+(g/1000).toFixed(2)+"</b></div>";}).join("");
  let top=null;Object.keys(bin.byDish).forEach(k=>{if(!top||bin.byDish[k]>bin.byDish[top])top=k;});
  set("binHeavy",top&&bin.total>0?"Heaviest dish so far: "+top+", "+(bin.byDish[top]/1000).toFixed(2)+" kg.":"No trays logged yet.");
  const level=f>=1?"Bin full. Empty it before the next tray.":f>=0.75?"Nearly full. Schedule a pickup for compost or biogas.":"Level normal.";
  set("binState",(binMsg?binMsg+" ":"")+level);
  $("#dropBtn").disabled=bin.total+120>CAP;
  $("#tape").innerHTML=bin.tape.length?bin.tape.map(r=>"<li><span>"+r.t+"</span><span>"+r.meal+" · "+r.dish.replace(/&/g,"&amp;")+"</span><b>"+(r.g/1000).toFixed(2)+" kg</b></li>").join(""):'<li class="empty">No trays logged since the bin was emptied.</li>';
}
$("#dropBtn").addEventListener("click",()=>{
  const g=Math.round((120+Math.random()*300)/10)*10, dish=dishSel.value;
  if(bin.total+g>CAP){binMsg="That tray does not fit.";renderBin();return;}
  bin.total+=g;bin.byMeal[binMeal]+=g;bin.byDish[dish]=(bin.byDish[dish]||0)+g;
  const d=new Date();bin.tape.unshift({t:pad(d.getHours())+":"+pad(d.getMinutes()),meal:binMeal,dish:dish,g:g});bin.tape=bin.tape.slice(0,5);
  binMsg="Logged "+g+" g of "+dish+" under "+binMeal+".";renderBin();
});
$("#emptyBtn").addEventListener("click",()=>{
  const kg=(bin.total/1000).toFixed(1);
  bin={total:0,byMeal:{Breakfast:0,Lunch:0,Snacks:0},byDish:{},tape:[]};
  binMsg="Bin emptied. "+kg+" kg went to compost or biogas.";renderBin();
});
renderMealChips();fillDishes();renderBin();

/* Dashboard */
const DAYS=["Mon","Tue","Wed","Thu","Fri","Sat"];
const WASTE={Breakfast:[9.4,8.1,8.8,7.6,8.3,5.2],Lunch:[31.2,27.5,29.8,24.6,26.1,14.9],Snacks:[12.6,11.2,10.4,9.8,11.5,7.1]};
const FE={All:4.8,Breakfast:6.1,Lunch:3.9,Snacks:7.4}, NGO={All:212,Breakfast:34,Lunch:148,Snacks:30};
const DISH=[
  {n:"Idli & sambar",m:"Breakfast",kg:19.8,served:260},{n:"Puttu & kadala",m:"Breakfast",kg:16.2,served:95},{n:"Upma",m:"Breakfast",kg:11.4,served:62},
  {n:"Rice",m:"Lunch",kg:71.6,served:520},{n:"Sambar & veg curry",m:"Lunch",kg:38.9,served:310},{n:"Chapati",m:"Lunch",kg:24.3,served:160},{n:"Salad & pickle",m:"Lunch",kg:19.3,served:48},
  {n:"Parippu vada",m:"Snacks",kg:24.1,served:90},{n:"Banana fry",m:"Snacks",kg:15.7,served:85},{n:"Samosa",m:"Snacks",kg:22.8,served:140}
].map(d=>Object.assign(d,{rate:d.kg/d.served*100}));
const status=r=>r>=20?["high","High"]:r>=14?["watch","Watch"]:["ok","On target"];
const esc=s=>String(s).replace(/&/g,"&amp;").replace(/</g,"&lt;");
let filter="All", selDay=0;
const selMeals=()=>filter==="All"?MEALS:[filter];
const totals=()=>DAYS.map((d,i)=>selMeals().reduce((s,m)=>s+WASTE[m][i],0));
function ticks(max){const step=max<=20?5:max<=60?10:20;const top=Math.ceil(max/step)*step;const arr=[];for(let v=0;v<=top;v+=step)arr.push(v);return {top,arr};}
function renderChips(){
  $("#mealChips").innerHTML=["All"].concat(MEALS).map(m=>'<button type="button" class="chip" data-meal="'+m+'" aria-pressed="'+(m===filter)+'">'+(m==="All"?"":'<span class="dot '+MCLS[m]+'"></span>')+(m==="All"?"All meals":m)+"</button>").join("");
}
function renderChart(){
  const tt=totals(), t=ticks(Math.max.apply(null,tt));
  const y=t.arr.map(v=>'<span style="bottom:'+(v/t.top*100)+'%">'+v+"</span>").join("");
  const grid=t.arr.filter(v=>v>0).map(v=>'<i class="gl" style="bottom:'+(v/t.top*100)+'%"></i>').join("");
  const cols=DAYS.map((d,i)=>{
    const segs=selMeals().map(m=>'<span class="seg s'+MCLS[m]+'" style="height:'+(WASTE[m][i]/tt[i]*100)+'%"></span>').join("");
    return '<button type="button" class="col" data-i="'+i+'" aria-pressed="'+(i===selDay)+'" aria-label="'+d+", "+tt[i].toFixed(1)+' kilograms">'
      +'<span class="stack" style="height:'+(tt[i]/t.top*100)+'%">'+segs+"</span>"
      +'<span class="tot" style="bottom:'+(tt[i]/t.top*100)+'%">'+tt[i].toFixed(1)+"</span>"
      +'<span class="xl">'+d+"</span></button>";
  }).join("");
  $("#chart").innerHTML='<div class="yaxis">'+y+'</div><div class="plot">'+grid+'<div class="cols">'+cols+"</div></div>";
  readout();
}
function readout(){
  const tt=totals();
  const parts=selMeals().map(m=>m+" "+WASTE[m][selDay].toFixed(1)+" kg");
  set("dayReadout",DAYS[selDay]+" · "+parts.join(" · ")+(filter==="All"?" · Total "+tt[selDay].toFixed(1)+" kg":""));
}
function setDay(i){
  selDay=i;$$("#chart .col").forEach(c=>c.setAttribute("aria-pressed",String(+c.dataset.i===i)));readout();
}
function renderDash(){
  const list=DISH.filter(d=>filter==="All"||d.m===filter);
  const sorted=list.slice().sort((a,b)=>b.rate-a.rate);
  const tt=totals();
  const topKg=list.slice().sort((a,b)=>b.kg-a.kg)[0];
  set("dkWaste",fmt(tt.reduce((a,b)=>a+b,0),1));
  set("dkTop",topKg.n); set("dkTopSub",fmt(topKg.kg,1)+" kg this week");
  set("dkFe",FE[filter].toFixed(1)+"%"); set("dkNgo",fmt(NGO[filter]));
  $("#dishList").innerHTML=sorted.map(d=>{const s=status(d.rate);
    return '<li class="dish"><div class="dish-head"><span class="dot '+MCLS[d.m]+'"></span><b>'+esc(d.n)+'</b><span class="pill '+s[0]+'">'+s[1]+'</span></div>'
      +'<div class="dish-bar"><div class="track"><i class="'+s[0]+'" style="width:'+Math.min(100,d.rate/45*100)+'%"></i></div><span>'+d.rate.toFixed(1)+"% · "+d.kg.toFixed(1)+" kg</span></div></li>";}).join("");
  const worst=sorted[0], highN=list.filter(d=>d.rate>=20).length, ins=[];
  let a=esc(worst.n)+" wastes "+worst.rate.toFixed(1)+"% of what is served at "+worst.m.toLowerCase()+". Offer a smaller default portion with a free top-up.";
  if(worst===topKg)a+=" It is also the heaviest source by weight.";
  ins.push(a);
  if(worst!==topKg)ins.push(esc(topKg.n)+" is the heaviest source at "+topKg.kg.toFixed(1)+" kg this week. Compare its batch size with what was served and trim the next batch.");
  ins.push(highN>0?highN+" of "+list.length+" dishes in this view are above a 20% waste rate. Review those first.":"No dish in this view is above a 20% waste rate. Keep tracking it.");
  $("#insights").innerHTML=ins.map(t=>"<li><span>"+t+"</span></li>").join("");
}
$("#mealChips").addEventListener("click",e=>{
  const b=e.target.closest("button[data-meal]");if(!b)return;
  filter=b.dataset.meal;const tt=totals();selDay=tt.indexOf(Math.max.apply(null,tt));
  renderChips();renderChart();renderDash();
});
$("#chart").addEventListener("click",e=>{const c=e.target.closest(".col");if(c)setDay(+c.dataset.i);});
$("#chart").addEventListener("mouseover",e=>{const c=e.target.closest(".col");if(c&&+c.dataset.i!==selDay)setDay(+c.dataset.i);});
$("#chart").addEventListener("focusin",e=>{const c=e.target.closest(".col");if(c&&+c.dataset.i!==selDay)setDay(+c.dataset.i);});
{const tt=totals();selDay=tt.indexOf(Math.max.apply(null,tt));}
renderChips();renderChart();renderDash();

/* Release check */
const boxes=$$("#gate input[type=checkbox]"), gs=$("#gateStatus");
function renderGate(){
  const n=boxes.filter(b=>b.checked).length;
  if(n===boxes.length){gs.dataset.s="ok";gs.textContent="Cleared. A partner NGO can collect this batch.";}
  else if(n===0){gs.dataset.s="hold";gs.textContent="On hold. Tick every check to release this batch.";}
  else{gs.dataset.s="part";gs.textContent=n+" of "+boxes.length+" checks done. Keep holding the batch.";}
}
boxes.forEach(b=>b.addEventListener("change",renderGate));
$("#gateReset").addEventListener("click",()=>{boxes.forEach(b=>{b.checked=false;});renderGate();});
renderGate();
})();
</script>

</body></html>