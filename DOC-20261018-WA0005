<!doctype html><html><head><meta charset=utf8><meta name=viewport content="width=device-width,initial-scale=1,viewport-fit=cover"><style>:root{color-scheme:light;box-sizing:border-box;padding-top:env(safe-area-inset-top,0px);padding-bottom:env(safe-area-inset-bottom,0px)}html{scroll-padding-top:env(safe-area-inset-top,0px)}body{margin:0;padding:0;font:14px -apple-system,BlinkMacSystemFont,sans-serif;background:#fff;color:#000}img{max-width:100%}[hidden]:not([hidden=until-found i]){display:none!important}</style></head><body>
<title>Smart Food-Waste Reduction System</title>
<meta name="claude:viewport-fit-sides" content="cover">
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Big+Shoulders+Display:wght@600;700;800&family=Figtree:wght@400;500;600;700&family=IBM+Plex+Mono:wght@400;500&display=swap">
<style>
/* Layout concept: a canteen day-sheet. Condensed menu-board headings, a weigh slip as the hero object, steel-and-leaf neutrals, and one turmeric highlight. */
:root{
  --bg:#ECEFE8; --surface:#F6F8F2; --surface-2:#DFE5D9; --fg:#0F1D16; --muted:#475A4E; --line:#C2CCBB;
  --leaf:#1E6B45; --on-leaf:#F3FAF5;
  --turmeric:#E8A317; --on-turmeric:#1B1203;
  --clay:#B33F29; --on-clay:#FFF6F3;
  --s-break:#D99A0B; --s-lunch:#1E6B45; --s-snack:#3B7A8A;
  --shadow:rgba(15,29,22,.45);
  --f-display:"Big Shoulders Display","Arial Narrow","Helvetica Neue",Arial,sans-serif;
  --f-body:"Figtree","Segoe UI",system-ui,-apple-system,sans-serif;
  --f-mono:"IBM Plex Mono",ui-monospace,Menlo,Consolas,monospace;
}
@media (prefers-color-scheme: dark){
  :root:not([data-theme="light"]){
    --bg:#0C1510; --surface:#131F18; --surface-2:#1C2B22; --fg:#E8EFE7; --muted:#9FB2A5; --line:#2C3D32;
    --leaf:#5CC48B; --on-leaf:#05130A;
    --turmeric:#F0B429; --on-turmeric:#1B1203;
    --clay:#E9785F; --on-clay:#1C0A05;
    --s-break:#F0B429; --s-lunch:#4DB57E; --s-snack:#6FB2BF;
    --shadow:rgba(0,0,0,.6);
    color-scheme:dark;
  }
}
:root[data-theme="dark"]{
  --bg:#0C1510; --surface:#131F18; --surface-2:#1C2B22; --fg:#E8EFE7; --muted:#9FB2A5; --line:#2C3D32;
  --leaf:#5CC48B; --on-leaf:#05130A;
  --turmeric:#F0B429; --on-turmeric:#1B1203;
  --clay:#E9785F; --on-clay:#1C0A05;
  --s-break:#F0B429; --s-lunch:#4DB57E; --s-snack:#6FB2BF;
  --shadow:rgba(0,0,0,.6);
  color-scheme:dark;
}

*,*::before,*::after{box-sizing:border-box}
html{scroll-behavior:smooth}
body{background:var(--bg);color:var(--fg);font:400 1rem/1.6 var(--f-body);-webkit-font-smoothing:antialiased;overflow-x:hidden}
body::before{content:"";position:fixed;inset:0 0 auto;height:env(safe-area-inset-top,0px);z-index:10;background:var(--bg)}
h1,h2,h3,h4,p,ul,ol,dl,dd,figure{margin:0}
a{color:inherit}
button,input,select{font:inherit;color:inherit}
:focus-visible{outline:3px solid var(--leaf);outline-offset:2px}
.skip{position:absolute;left:-999px;top:0;background:var(--fg);color:var(--bg);padding:.6rem 1rem;z-index:50}
.skip:focus{left:16px;top:calc(8px + env(safe-area-inset-top,0px))}

.wrap{width:100%;max-width:1200px;margin-inline:auto;padding-left:max(16px,env(safe-area-inset-left,0px));padding-right:max(16px,env(safe-area-inset-right,0px))}
.sec{padding-block:clamp(56px,8vw,104px);scroll-margin-top:calc(64px + env(safe-area-inset-top,0px))}
.band-alt{background:var(--surface);border-block:1px solid var(--line)}
.band-ink{--bg:#09110C;--surface:#111E16;--surface-2:#1A2A20;--fg:#E8EFE7;--muted:#9FB2A5;--line:#2A3B30;--leaf:#5CC48B;--on-leaf:#05130A;--turmeric:#F0B429;--on-turmeric:#1B1203;--clay:#E9785F;--s-break:#F0B429;--s-lunch:#4DB57E;--s-snack:#6FB2BF;--shadow:rgba(0,0,0,.6);background:var(--bg);color:var(--fg)}

.eyebrow{font:500 .75rem/1.4 var(--f-mono);letter-spacing:.14em;text-transform:uppercase;color:var(--muted)}
.h2{font-family:var(--f-display);font-weight:800;font-size:clamp(2.1rem,4.8vw,3.4rem);line-height:.98;text-transform:uppercase;letter-spacing:.005em;margin-top:.5rem;text-wrap:balance}
.sec-head{max-width:760px;margin-bottom:clamp(28px,4vw,48px)}
.lead{font-size:1.125rem;color:var(--muted);margin-top:1rem;max-width:62ch}
.muted{color:var(--muted)}
.mono{font-family:var(--f-mono);font-variant-numeric:tabular-nums}
.num{font-variant-numeric:tabular-nums}

.btn{display:inline-flex;align-items:center;justify-content:center;gap:.5rem;min-height:46px;padding:.75rem 1.3rem;border-radius:4px;border:1.5px solid var(--fg);font-weight:600;text-decoration:none;cursor:pointer;background:transparent;color:var(--fg);transition:transform .15s ease,background .15s ease}
.btn:hover{transform:translateY(-1px)}
.btn-primary{background:var(--leaf);border-color:var(--leaf);color:var(--on-leaf)}
.btn:disabled{opacity:.45;cursor:not-allowed;transform:none}
.chip{display:inline-flex;align-items:center;gap:.5rem;min-height:40px;padding:.55rem 1rem;border:1.5px solid var(--line);border-radius:999px;background:transparent;font-weight:600;font-size:.875rem;cursor:pointer}
.chip:hover{border-color:var(--fg)}
.chip[aria-pressed="true"]{background:var(--fg);color:var(--bg);border-color:var(--fg)}
.dot{width:.7rem;height:.7rem;border-radius:50%;display:inline-block;flex:none;background:var(--muted)}
.dot.b{background:var(--s-break)}.dot.l{background:var(--s-lunch)}.dot.s{background:var(--s-snack)}
.pill{display:inline-block;font:500 .6875rem/1 var(--f-mono);letter-spacing:.08em;text-transform:uppercase;padding:.35rem .55rem;border-radius:999px;border:1px solid currentColor;white-space:nowrap}
.pill.sample{background:var(--turmeric);color:var(--on-turmeric);border-color:transparent}
.pill.high{background:var(--clay);color:var(--on-clay);border-color:transparent}
.pill.watch{background:var(--turmeric);color:var(--on-turmeric);border-color:transparent}
.pill.ok{background:var(--leaf);color:var(--on-leaf);border-color:transparent}
.panel{background:var(--surface);border:1px solid var(--line);border-radius:6px;padding:clamp(1rem,2.4vw,1.5rem)}
.panel h3{font:500 .75rem/1.4 var(--f-mono);letter-spacing:.12em;text-transform:uppercase;color:var(--muted);margin-bottom:.9rem}
.track{height:.7rem;background:var(--surface-2);border-radius:2px;overflow:hidden;min-width:0}
.track>i{display:block;height:100%;background:var(--leaf);border-radius:2px}

/* Header */
.site{position:sticky;top:env(safe-area-inset-top,0px);z-index:20;background:var(--bg);border-bottom:1px solid var(--line)}
.hbar{display:flex;align-items:center;gap:1rem;min-height:64px}
.brand{display:flex;align-items:center;gap:.65rem;text-decoration:none;font-family:var(--f-display);font-weight:800;font-size:1.3rem;text-transform:uppercase;letter-spacing:.02em;line-height:1;min-width:0}
.brand .short{display:none}
.nav{margin-left:auto}
.nav ul{list-style:none;padding:0;display:flex;gap:1.35rem}
.nav a{font-size:.875rem;font-weight:500;text-decoration:none;color:var(--muted);padding:.4rem 0;border-bottom:3px solid transparent}
.nav a:hover{color:var(--fg)}
.nav a[aria-current="true"]{color:var(--fg);border-bottom-color:var(--turmeric)}
.actions{display:flex;gap:.5rem}
.icon-btn{width:42px;height:42px;display:grid;place-items:center;border:1.5px solid var(--line);border-radius:50%;background:transparent;cursor:pointer}
.icon-btn:hover{border-color:var(--fg)}
.icon-btn svg{width:20px;height:20px}
.menu-btn{display:none}
.i-sun{display:none}
#themeBtn[data-mode="dark"] .i-sun{display:block}
#themeBtn[data-mode="dark"] .i-moon{display:none}
@media (max-width:1180px){.brand .long{display:none}.brand .short{display:inline}}
@media (max-width:1000px){
  .menu-btn{display:grid}
  .actions{margin-left:auto}
  .nav{display:none;position:absolute;top:100%;left:0;right:0;margin:0;background:var(--bg);border-bottom:1px solid var(--line);padding:.5rem max(16px,env(safe-area-inset-right,0px)) 1rem max(16px,env(safe-area-inset-left,0px))}
  .nav.open{display:block}
  .nav ul{flex-direction:column;gap:0}
  .nav a{display:block;padding:.85rem 0;font-size:1rem;border-bottom:1px solid var(--line)}
}

/* Hero */
.hero{padding-block:clamp(40px,6vw,88px) clamp(64px,8vw,104px);scroll-margin-top:80px}
.hero-grid{display:grid;grid-template-columns:minmax(0,1.2fr) minmax(0,.8fr);gap:clamp(36px,5vw,72px);align-items:center}
.hero h1{font-family:var(--f-display);font-weight:800;text-transform:uppercase;font-size:clamp(2.7rem,8.4vw,5.6rem);line-height:.92;margin:1rem 0 1.4rem}
.hero h1 .ln{display:block}
.hero h1 mark{background:var(--turmeric);color:var(--on-turmeric);padding:0 .14em;-webkit-box-decoration-break:clone;box-decoration-break:clone}
.hero .lead{font-size:clamp(1.05rem,2vw,1.25rem);color:var(--fg);max-width:50ch}
.cta-row{display:flex;flex-wrap:wrap;gap:.75rem;margin-top:1.8rem}
.slip{position:relative;background:var(--surface);border:1px solid var(--line);border-bottom:0;padding:1.4rem 1.4rem 1.7rem;font:400 .85rem/1.5 var(--f-mono);transform:rotate(1.2deg);box-shadow:0 22px 40px -26px var(--shadow);margin-bottom:10px;min-width:0}
.slip::after{content:"";position:absolute;left:-1px;right:-1px;top:100%;height:9px;background:linear-gradient(135deg,var(--surface) 50%,transparent 50%) left top/18px 9px repeat-x,linear-gradient(225deg,var(--surface) 50%,transparent 50%) left top/18px 9px repeat-x}
.slip-head{display:flex;justify-content:space-between;align-items:center;gap:.5rem;text-transform:uppercase;letter-spacing:.1em;font-size:.8rem}
.slip-sub{color:var(--muted);margin:.35rem 0 1rem;font-size:.8rem}
.slip .row{display:flex;align-items:baseline;gap:.5rem;padding:.2rem 0}
.slip .row i{flex:1;min-width:1rem;border-bottom:1.5px dotted var(--muted);transform:translateY(-3px)}
.slip .row b{font-weight:500;font-variant-numeric:tabular-nums}
.slip .row.hl{background:var(--turmeric);color:var(--on-turmeric);margin:.25rem -.6rem;padding:.3rem .6rem}
.slip .row.hl i{border-color:var(--on-turmeric)}
.slip hr{border:0;border-top:1.5px dashed var(--muted);margin:.8rem 0}
.slip-foot{margin-top:1rem;color:var(--muted);font-size:.75rem}
@media (max-width:900px){.hero-grid{grid-template-columns:minmax(0,1fr)}.slip{transform:none;max-width:480px}}

/* Problem */
.problem-grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:clamp(28px,5vw,64px)}
.ledger{list-style:none;padding:0;border-top:2px solid var(--fg)}
.ledger li{padding:1rem 0;border-bottom:1px solid var(--line)}
.ledger b{display:block;font-family:var(--f-display);font-weight:700;font-size:1.45rem;text-transform:uppercase;letter-spacing:.01em;line-height:1.1}
.ledger span{display:block;color:var(--muted);margin-top:.2rem}
.ledger-title{font:500 .75rem/1.4 var(--f-mono);letter-spacing:.14em;text-transform:uppercase;color:var(--muted);margin-bottom:.75rem}
.stats{display:grid;grid-template-columns:repeat(auto-fit,minmax(200px,1fr));margin-top:clamp(40px,6vw,72px);border-top:2px solid var(--fg)}
.stat{padding:1.1rem 1.2rem 1.2rem 0}
.stat+.stat{padding-left:1.2rem;border-left:1px solid var(--line)}
.stat b{display:block;font-family:var(--f-display);font-weight:800;font-size:clamp(2.4rem,5vw,3.4rem);line-height:1;letter-spacing:.005em}
.stat span{display:block;color:var(--muted);margin-top:.4rem;max-width:26ch}
.src{font-size:.8125rem;color:var(--muted);margin-top:.9rem}
@media (max-width:760px){.problem-grid{grid-template-columns:minmax(0,1fr)}.stat+.stat{border-left:0;padding-left:0;border-top:1px solid var(--line)}}

/* Loop */
.loop{list-style:none;padding:0;display:grid;grid-template-columns:repeat(5,minmax(0,1fr))}
.loop li{position:relative;padding:3.3rem 1.1rem 0 0}
.loop li::before{content:"";position:absolute;left:0;right:0;top:1.05rem;border-top:2px solid var(--fg)}
.loop .n{position:absolute;z-index:1;top:0;left:0;width:2.1rem;height:2.1rem;border-radius:50%;background:var(--fg);color:var(--bg);display:grid;place-items:center;font:500 .85rem/1 var(--f-mono)}
.loop h3{font-family:var(--f-display);font-weight:700;font-size:1.55rem;text-transform:uppercase;line-height:1.05;letter-spacing:.01em}
.loop p{color:var(--muted);margin-top:.4rem;font-size:.95rem}
.tag{display:inline-flex;align-items:center;gap:.4rem;margin-top:.8rem;font:500 .6875rem/1 var(--f-mono);letter-spacing:.08em;text-transform:uppercase;color:var(--muted)}
.tag i{width:.6rem;height:.6rem;border-radius:2px;background:var(--s-break)}
.tag.m i{background:var(--s-snack)}.tag.r i{background:var(--s-lunch)}
.return{display:flex;gap:1rem;align-items:flex-start;margin-top:clamp(28px,4vw,44px);padding:1.1rem 1.3rem;border:2px dashed var(--line);border-radius:6px}
.return svg{width:28px;height:28px;flex:none;color:var(--leaf);margin-top:.15rem}
.return p{max-width:70ch}
@media (max-width:1000px){
  .loop{grid-template-columns:minmax(0,1fr)}
  .loop li{padding:0 0 1.8rem 3.2rem}
  .loop li::before{left:1.05rem;right:auto;top:0;bottom:0;border-top:0;border-left:2px solid var(--fg)}
  .loop li:last-child::before{bottom:auto;height:1.05rem}
}

/* Planner */
.planner{display:grid;grid-template-columns:minmax(0,.9fr) minmax(0,1.1fr);gap:clamp(20px,3vw,40px);align-items:start}
.controls{display:grid;gap:1.35rem}
.field{border:0;padding:0;margin:0;min-width:0}
.field>label,.field>legend{display:flex;justify-content:space-between;align-items:baseline;gap:1rem;font-weight:600;margin-bottom:.45rem;padding:0;width:100%}
.field .val{font:500 .9rem/1 var(--f-mono);font-variant-numeric:tabular-nums;color:var(--leaf)}
input[type=range]{width:100%;accent-color:var(--leaf);height:28px;margin:0}
.seg-grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:8px}
.seg-grid label{position:relative;display:block}
.seg-grid input{position:absolute;inset:0;opacity:0;margin:0;cursor:pointer}
.seg-grid span{display:flex;justify-content:space-between;gap:.5rem;padding:.65rem .8rem;border:1.5px solid var(--line);border-radius:6px;background:var(--bg);font-weight:500;font-size:.9rem}
.seg-grid small{font:400 .75rem/1.6 var(--f-mono);opacity:.8}
.seg-grid input:checked+span{background:var(--fg);color:var(--bg);border-color:var(--fg)}
.seg-grid input:focus-visible+span{outline:3px solid var(--leaf);outline-offset:2px}
details.assump{border-top:1px solid var(--line);padding-top:1rem}
details.assump summary{cursor:pointer;font-weight:600}
.assump-body{display:grid;gap:.9rem;margin-top:1rem}
.assump-row{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:12px}
.assump label{display:block;font-size:.85rem;color:var(--muted);margin-bottom:.3rem}
input[type=number],select{width:100%;min-height:44px;padding:.55rem .75rem;border:1.5px solid var(--line);border-radius:6px;background:var(--bg);color:var(--fg)}
.assump ul{padding-left:1.1rem;color:var(--muted);font-size:.875rem;display:grid;gap:.2rem}
.results{display:grid;gap:1.6rem}
.big{font-family:var(--f-display);font-weight:800;font-size:clamp(3.2rem,8vw,5rem);line-height:.9;margin-top:.4rem;font-variant-numeric:tabular-nums}
.big .unit{font-size:1.4rem;font-weight:700;text-transform:uppercase;letter-spacing:.02em;color:var(--muted)}
.calc{font:400 .85rem/1.5 var(--f-mono);color:var(--muted);margin-top:.5rem}
.cmp h4{font-weight:600;font-size:.95rem}
.bar-row{display:grid;grid-template-columns:5.6rem minmax(0,1fr) 4.6rem;gap:.75rem;align-items:center;margin-top:.55rem;font-size:.9rem}
.bar-row .bar-track{position:relative;height:1.55rem;background:var(--surface-2);border-radius:3px}
.bar-row .bar{height:100%;border-radius:3px;transition:width .35s ease;min-width:2px}
.bar.fixed{background:var(--clay)}.bar.smart{background:var(--leaf)}
.bar-row .mark{position:absolute;top:-5px;bottom:-5px;width:2px;background:var(--fg);transition:left .35s ease}
.bar-row .v{font:500 .85rem/1 var(--f-mono);text-align:right;font-variant-numeric:tabular-nums}
.legend-note{font-size:.8125rem;color:var(--muted);margin-top:.55rem}
.warn{margin-top:.55rem;font-size:.875rem;font-weight:600;color:var(--clay)}
.kpis{display:grid;grid-template-columns:repeat(auto-fit,minmax(150px,1fr));border-top:2px solid var(--fg)}
.kpi{padding:.9rem 1rem .4rem 0}
.kpi+.kpi{padding-left:1rem;border-left:1px solid var(--line)}
.kpi dt{font:500 .75rem/1.4 var(--f-mono);letter-spacing:.1em;text-transform:uppercase;color:var(--muted)}
.kpi dd{font-family:var(--f-display);font-weight:800;font-size:2.2rem;line-height:1.05;margin-top:.2rem;font-variant-numeric:tabular-nums}
.kpi small{display:block;color:var(--muted);font-size:.8125rem;margin-top:.1rem}
@media (max-width:900px){.planner{grid-template-columns:minmax(0,1fr)}.kpi+.kpi{border-left:0;padding-left:0;border-top:1px solid var(--line)}.kpi{padding-bottom:.8rem}}
@media (max-width:480px){.bar-row{grid-template-columns:4.6rem minmax(0,1fr) 4rem;gap:.5rem}}

/* Smart bin */
.bin-grid{display:grid;grid-template-columns:minmax(0,1.1fr) minmax(0,.9fr);gap:clamp(24px,4vw,56px);align-items:start}
.bin-top{display:grid;grid-template-columns:minmax(0,170px) minmax(0,1fr);gap:1.4rem;align-items:center}
.bin-svg{width:100%;max-width:170px;height:auto;display:block}
.bin-svg .body{fill:var(--surface-2);stroke:var(--muted);stroke-width:2}
.bin-svg .lid{fill:var(--muted)}
.bin-svg .fillr{fill:var(--turmeric);opacity:.9;transition:y .4s ease,height .4s ease}
.bin-svg .plat{fill:var(--line)}
.bin-svg .tickl{stroke:var(--muted);stroke-width:1.5;opacity:.7}
.lcd{background:#050B07;border:1px solid var(--line);border-radius:4px;padding:.8rem 1rem;color:#7CF0B0;font-family:var(--f-mono)}
.lcd small{display:block;font-size:.6875rem;letter-spacing:.14em;text-transform:uppercase;opacity:.75}
.lcd .read{font-size:clamp(2.2rem,6vw,3rem);line-height:1.1;font-weight:500;font-variant-numeric:tabular-nums}
.lcd .read span{font-size:1rem;margin-left:.4rem;opacity:.8}
.lcd .pct{font-size:.8rem;opacity:.8}
.mrows{display:grid;gap:.5rem;margin-top:.9rem;font-size:.875rem}
.mrow{display:grid;grid-template-columns:5.2rem minmax(0,1fr) 4.2rem;gap:.6rem;align-items:center}
.mrow b{font:500 .8rem/1 var(--f-mono);text-align:right}
.mrow .track>i.b{background:var(--s-break)}.mrow .track>i.l{background:var(--s-lunch)}.mrow .track>i.s{background:var(--s-snack)}
.heavy{font-size:.875rem;color:var(--muted);margin-top:.7rem}
.bin-ctl{display:grid;gap:1rem;margin-top:1.4rem;padding-top:1.3rem;border-top:1px solid var(--line)}
.chips{display:flex;flex-wrap:wrap;gap:.5rem}
.ctl-row{display:grid;grid-template-columns:minmax(0,1fr);gap:.5rem}
.ctl-btns{display:flex;flex-wrap:wrap;gap:.6rem}
.ctl-lbl{font-size:.85rem;font-weight:600;display:block;margin-bottom:.35rem}
.bin-msg{font-size:.9rem;min-height:2.9em;color:var(--muted)}
.tape{list-style:none;padding:0;margin-top:.4rem;font:400 .8rem/1.4 var(--f-mono)}
.tape li{display:grid;grid-template-columns:3.2rem minmax(0,1fr) auto;gap:.7rem;padding:.45rem 0;border-bottom:1px dashed var(--line)}
.tape li.empty{display:block;color:var(--muted)}
.tape b{font-weight:500}
.chain{list-style:none;padding:0;margin-top:1rem}
.chain li{position:relative;padding:0 0 1.5rem 2.2rem}
.chain li::before{content:"";position:absolute;left:.45rem;top:1.15rem;bottom:-.1rem;border-left:2px solid var(--line)}
.chain li:last-child{padding-bottom:0}
.chain li:last-child::before{display:none}
.chain li::after{content:"";position:absolute;left:0;top:.28rem;width:.95rem;height:.95rem;border:2px solid var(--leaf);background:var(--bg);border-radius:2px}
